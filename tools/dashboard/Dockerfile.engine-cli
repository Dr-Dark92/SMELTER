FROM python:3.12-slim-bookworm@sha256:57d96f71de145a98e7ceca18ee4ade77bba4103a33a72dfaea026b23625c6bf0
# Self-contained .NET executable; invariant mode avoids a separately installed ICU.
# The installer supplies only checksum-verified release files, licenses and lock.
COPY runtime/ /opt/engine-cli/
COPY requirements-engine-cli.json /opt/engine-cli/requirements.json
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_EnableDiagnostics=0
RUN chmod -R a+rX /opt/engine-cli && chmod 755 /opt/engine-cli/repak/repak /opt/engine-cli/retoc/retoc /opt/engine-cli/unity/UnityDataTool
USER 65534:65534
WORKDIR /tmp
